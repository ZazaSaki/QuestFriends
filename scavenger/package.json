{
  "name": "scavenger",
  "version": "1.0.0",
  "description": "Real-time, location-based scavenger-hunt quest game backend",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "npx prisma generate && npx prisma db push && node src/index.js",
    "dev": "node --watch src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "minio": "^8.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
