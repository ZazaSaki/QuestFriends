POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# --- MinIO ---
MINIO_USER=admin
MINIO_PASSWORD=SuperSecretPassword123

# Public origin the backend hands out in media URLs (MINIO_EXTERNAL_URL).
#   • Local:      http://localhost:9110   (browser reaches MinIO directly)
#   • Cloudflare: https://YOUR_HOST       (media routed via the manager's /scavenger proxy)
MINIO_URL=http://localhost:9110

# Public origin of the player SPA. The manager bakes this into the room join
# link and the room QR code shown in the Live Monitor, so a player can scan it
# with any phone camera. Leave empty and the QR encodes the bare room UUID,
# which only the player app's own scanner understands.
#   • Local:      http://localhost:9103
#   • LAN/phones: http://192.168.x.x:9103
#   • Cloudflare: https://YOUR_PLAYER_HOST
PLAYER_URL=http://localhost:9103

# Backend URL for the God-Mode QA dashboard (tester on :9121) only.
# The manager UI does NOT use this — it is same-origin via its own nginx proxy.
#   • Local:      http://localhost:9101
#   • Cloudflare: https://YOUR_HOST
BACKEND_URL=http://localhost:9101
